#!/usr/bin/env bash
# ppm — personal package manager
#
# Commands are implemented in lib/:
#   sources.sh     src, update, package
#   packages.sh    list, show, path, deps
#   installer.sh   install, remove
#   file.sh        file (claim, reset)
#   completion.sh  completion
# core.sh holds the functions package hooks can call (install_dep, user_message, ...)
# platform.sh detects the platform and locates Homebrew and its owner
set -euo pipefail

list_commands() {
  echo "Available commands: src, update, list, install, remove, show, deps, path, cd, package, file, completion"
}

if [[ $# -eq 0 ]]; then
  echo "Error: Requires a command"
  list_commands
  exit 1
fi

# XDG directories
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# PPM directories — overridable for alternate profiles
PPM_CONFIG_HOME="${PPM_CONFIG_HOME:-$XDG_CONFIG_HOME/ppm}"
PPM_DATA_HOME="${PPM_DATA_HOME:-$XDG_DATA_HOME/ppm}"
PPM_CACHE_HOME="${PPM_CACHE_HOME:-$XDG_CACHE_HOME/ppm}"

# Derived paths (not overridable — derived from above)
PPM_SOURCES_FILE="$PPM_CONFIG_HOME/sources.list"
PPM_INSTALLED_DIR="$PPM_DATA_HOME/.installed"
PPM_LIB_DIR="${HOME}/.local/lib/ppm"
BIN_DIR="${HOME}/.local/bin"

# Resolve the repo directory (works through symlinks)
_resolve_path() {
  local path="$1"
  while [[ -L "$path" ]]; do
    local dir="$(cd "$(dirname "$path")" && pwd)"
    path="$(readlink "$path")"
    [[ "$path" != /* ]] && path="$dir/$path"
  done
  echo "$(cd "$(dirname "$path")" && pwd)"
}
PPM_REPO_DIR="$(_resolve_path "$0")"

# Source ppm's libraries, then package-contributed extensions
for lib_file in "$PPM_REPO_DIR"/lib/*.sh "$PPM_LIB_DIR"/*.sh; do
  [[ -f "$lib_file" ]] && source "$lib_file"
done

# Put Homebrew on PATH even without the user's shell setup (cron, sudo -iu, env -i)
brew_env

# Entrypoint for commands that need sources.list and ppm.conf
main() {
  if [[ ! -f $PPM_SOURCES_FILE ]]; then
    echo "ERROR: Missing $PPM_SOURCES_FILE"
    exit 1
  fi
  # Source all *.conf files from PPM_CONFIG_HOME
  set -a
  for conf_file in "$PPM_CONFIG_HOME"/*.conf; do
    [[ -f "$conf_file" ]] && source "$conf_file"
  done
  set +a

  # Flags are locals of main(); the commands it calls (and their helpers) read them
  # through bash's dynamic scoping
  local command="$1" config=false force=false reinstall=false skip_deps=false
  shift

  # Command aliases
  [[ "$command" == "ls" ]] && command="list"
  # Not named file() so the system `file` binary isn't shadowed in package hooks
  [[ "$command" == "file" ]] && command="file_command"

  local passthrough_args=()
  while [[ "$#" -gt 0 && "$1" == -* ]]; do
    case "$1" in
      -c) config=true ;;
      -f) force=true ;;
      -r) reinstall=true ;;
      -s) skip_deps=true ;;
      --debug) PPM_DEBUG=true ;;
      --*) passthrough_args+=("$1") ;;
      *) echo "Unknown flag: $1"; exit 1 ;;
    esac
    shift
  done
  set -- ${passthrough_args[@]+"${passthrough_args[@]}"} "$@"

  if declare -f "$command" > /dev/null; then
    "$command" "$@"
  else
    echo "Error: Unknown command '$command'"
    list_commands
    exit 1
  fi
}

# Skip main() setup for commands that don't need it
case "${1:-}" in
  completion) completion "${@:2}" ;;
  src) src "${@:2}" ;;
  package) package "${@:2}" ;;
  *) main "$@" ;;
esac

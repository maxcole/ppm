# ppm test image: a fresh Debian 13 machine with two users
# Homebrew's prerequisites are left out on purpose; install.sh installs them
FROM docker.io/library/debian:trixie

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates locales ncurses-term sudo wget \
 && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

# Host repos are mounted at /src and owned by another uid
RUN printf '[safe]\n\tdirectory = *\n' > /etc/gitconfig

# owner: sudo with a password (so the prompt can be tested); other: no sudo
RUN useradd -m -u 1000 -s /bin/bash -G sudo owner \
 && echo 'owner:owner' | chpasswd \
 && useradd -m -u 1001 -s /bin/bash other

CMD ["sleep", "infinity"]

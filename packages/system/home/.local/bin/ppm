#!/usr/bin/env bash
# ppm — personal package manager
#
# ppm is itself the `ppm/system` package: this script and its libraries are stowed
# from packages/system/home/ into ~/.local/bin and ~/.local/lib/ppm.
#
# Commands are implemented in the libraries under ~/.local/lib/ppm/ (stowed from
# packages/system/home/.local/lib/ppm/):
#   sources.sh     src (add, remove, list, ssh, update), customize
#   packages.sh    list, show, path, deps
#   installer.sh   install, remove
#   file.sh        file (add, claim, reset, protect, unprotect)
#   completion.sh  completion
# core.sh holds the functions package hooks can call (install_dep, user_message, ...)
# platform.sh detects the platform and locates Homebrew and its owner
set -euo pipefail

list_commands() {
  echo "Available commands: src, list, install, remove, show, deps, path, cd, customize, file, completion"
}

if [[ $# -eq 0 ]]; then
  echo "Error: Requires a command"
  list_commands
  exit 1
fi

# XDG directories
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# PPM directories — overridable for alternate profiles
PPM_CONFIG_HOME="${PPM_CONFIG_HOME:-$XDG_CONFIG_HOME/ppm}"
PPM_DATA_HOME="${PPM_DATA_HOME:-$XDG_DATA_HOME/ppm}"
PPM_CACHE_HOME="${PPM_CACHE_HOME:-$XDG_CACHE_HOME/ppm}"

# Derived paths (not overridable — derived from above)
# Repos come from two lists: system.list (shipped by ppm/system, ppm-managed) and
# user.list (yours). sources.list is the pre-split legacy name, still read as the user list.
PPM_SYSTEM_SOURCES="$PPM_CONFIG_HOME/system.list"
PPM_USER_SOURCES="$PPM_CONFIG_HOME/user.list"
PPM_LEGACY_SOURCES="$PPM_CONFIG_HOME/sources.list"
PPM_INSTALLED_DIR="$PPM_DATA_HOME/.installed"
PPM_LIB_DIR="${HOME}/.local/lib/ppm"
BIN_DIR="${HOME}/.local/bin"
# The ppm repo's clone location (fixed name under PPM_DATA_HOME); ppm itself is the
# ppm/system package stowed from packages/system/ within it
PPM_REPO_DIR="$PPM_DATA_HOME/ppm"

# Resolve a path through symlinks to the directory of its real target
# (used here and by package extensions such as dev's container.sh)
_resolve_path() {
  local path="$1"
  while [[ -L "$path" ]]; do
    local dir="$(cd "$(dirname "$path")" && pwd)"
    path="$(readlink "$path")"
    [[ "$path" != /* ]] && path="$dir/$path"
  done
  echo "$(cd "$(dirname "$path")" && pwd)"
}

# Source ppm's own libraries and any package-contributed extensions. Both live in
# PPM_LIB_DIR: ppm's core libs are stowed there by the ppm/system package, alongside
# extensions from other packages (e.g. dev's container.sh, user.sh).
for lib_file in "$PPM_LIB_DIR"/*.sh; do
  [[ -f "$lib_file" ]] && source "$lib_file"
done

# Put Homebrew on PATH even without the user's shell setup (cron, sudo -iu, env -i)
brew_env

# Entrypoint for commands that need a source list and ppm.conf
main() {
  if [[ ! -f "$PPM_SYSTEM_SOURCES" && ! -f "$PPM_USER_SOURCES" && ! -f "$PPM_LEGACY_SOURCES" ]]; then
    echo "ERROR: No sources configured (expected $PPM_USER_SOURCES or $PPM_SYSTEM_SOURCES)"
    exit 1
  fi
  # Source all *.conf files from PPM_CONFIG_HOME
  set -a
  for conf_file in "$PPM_CONFIG_HOME"/*.conf; do
    [[ -f "$conf_file" ]] && source "$conf_file"
  done
  set +a

  # Flags are locals of main(); the commands it calls (and their helpers) read them
  # through bash's dynamic scoping
  local command="$1" config=false force=false reinstall=false skip_deps=false
  shift

  # Command aliases
  [[ "$command" == "ls" ]] && command="list"
  # Not named file() so the system `file` binary isn't shadowed in package hooks
  [[ "$command" == "file" ]] && command="file_command"

  local passthrough_args=()
  while [[ "$#" -gt 0 && "$1" == -* ]]; do
    case "$1" in
      -c) config=true ;;
      -f) force=true ;;
      -r) reinstall=true ;;
      -s) skip_deps=true ;;
      --debug) PPM_DEBUG=true ;;
      --*) passthrough_args+=("$1") ;;
      *) echo "Unknown flag: $1"; exit 1 ;;
    esac
    shift
  done
  set -- ${passthrough_args[@]+"${passthrough_args[@]}"} "$@"

  if declare -f "$command" > /dev/null; then
    "$command" "$@"
  else
    echo "Error: Unknown command '$command'"
    list_commands
    exit 1
  fi
}

# Skip main() setup for commands that don't need it
case "${1:-}" in
  completion) completion "${@:2}" ;;
  src) src "${@:2}" ;;
  *) main "$@" ;;
esac

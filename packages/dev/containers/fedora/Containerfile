# ppm test image: a fresh Fedora machine with two users
# Homebrew's prerequisites are left out on purpose; install.sh installs them
FROM docker.io/library/fedora:latest

RUN dnf install -y glibc-langpack-en ncurses-term shadow-utils sudo \
 && dnf clean all

ENV LANG=en_US.UTF-8

# Host repos are mounted at /src and owned by another uid
RUN printf '[safe]\n\tdirectory = *\n' > /etc/gitconfig

# owner: sudo with a password (so the prompt can be tested); other: no sudo
RUN useradd -m -u 1000 -s /bin/bash -G wheel owner \
 && echo 'owner:owner' | chpasswd \
 && useradd -m -u 1001 -s /bin/bash other

CMD ["sleep", "infinity"]
